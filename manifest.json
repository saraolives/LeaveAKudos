{
  "manifest_version": 3,
  "name": "LeaveAKudos",
  "version": "1.0",
   "permissions": [
    "storage"
  ],
  

  "description": "Inserts the HTML code for leaving kudos into Dreamwidth entries",

  "icons": {
    "48": "icons/heart-solid-full.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "florianschild@dreamwidth.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*.dreamwidth.org/entry/new*"],
      "js": ["leaveakudos.js"]
    }
  ]
}